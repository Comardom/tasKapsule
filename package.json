{
  "name": "taskapsule",
  "description": "Task management app with Electron + Vue + Go",
  "author": "Comardom",
  "version": "0.1.0",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev:frontend": "cd frontend && pnpm dev",
    "dev:backend": "cd backend && go run .",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "run-p dev:frontend dev:backend dev:electron",
    "build:frontend": "cd frontend && pnpm build",
    "build:backend": "cd backend && go build -o taskapsule-server",
    "build:electron": "tsc -p electron",
    "dist": "cross-env NODE_ENV=production pnpm build:frontend && pnpm build:backend && pnpm build:electron && electron-builder"
  },
  "build": {
  "appId": "xyz.taskapsule",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/dist/**/*"
  ],
  "extraResources": [
    {
      "from": "frontend/dist",
      "to": "frontend/dist"
    },
    {
      "from": "backend/taskapsule-server",
      "to": "taskapsule-server"
    }
  ]
},
  "devDependencies": {
    "@types/node": "^25.5.0",
    "cross-env": "^10.1.0",
    "electron": "42.0.0-alpha.5",
    "electron-builder": "^26.8.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  }
}
